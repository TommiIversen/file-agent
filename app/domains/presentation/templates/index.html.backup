<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Transfer Agent - Real-time Monitor</title>
    <!-- Tailwind CSS CDN -->
    <link rel="stylesheet" href="/static/css/tailwind.css">

    <!-- File Transfer Agent - Modular Architecture (Load BEFORE Alpine.js) -->
    <!-- Stores -->
    <script src="/static/js/stores/connectionStore.js"></script>
    <script src="/static/js/stores/fileStore.js"></script>
    <script src="/static/js/stores/storageStore.js"></script>
    <script src="/static/js/stores/uiStore.js"></script>
    <script src="/static/js/stores/logViewerStore.js"></script>
    <script src="/static/js/stores/eventsViewerStore.js"></script>
    <script src="/static/js/stores/settingsStore.js"></script>
    <script src="/static/js/stores/directoryBrowserStore.js"></script>
    <script src="/static/js/stores/ingestStore.js"></script>


    <!-- Services -->
    <script src="/static/js/services/messageHandler.js"></script>
    <script src="/static/js/services/uiHelpers.js"></script>

    <!-- Main Application -->
    <script src="/static/js/app.js"></script>

    <!-- Alpine.js CDN (Load LAST) -->
    <script defer src="/static/js/jslib/alpinejs.js"></script>
    <style>
        /* Main background gradient */
        .gradientHolder {
            background: radial-gradient(ellipse at center, rgb(222, 67, 202) 0%, rgba(20, 25, 44, 0.96) 0%, rgba(10, 14, 24, 0.96) 100%);
        }

        .status-indicator {
            width: 12px;
            height: 12px;
        }

        .progress-animation {
            background: linear-gradient(90deg, #3b82f6, #1d4ed8, #3b82f6);
            background-size: 200% 100%;
            animation: progress-shine 2s infinite;
        }

        @keyframes progress-shine {
            0% {
                background-position: 200% 0;
            }
            100% {
                background-position: -200% 0;
            }
        }
    </style>
</head>
<body>
<body class="gradientHolder min-h-screen"
      x-data="{}"
      x-init="() => { /* Application will auto-initialize via app.js */ }">

<div class="container mx-auto p-4 max-w-7xl">
    <!-- Header with Status -->
    <div class="bg-gray-800 bg-opacity-80 rounded-lg shadow-lg p-4 text-white">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-center mb-4">
            <!-- Titel (venstre) -->
            <div>
                <h1 class="text-3xl font-bold flex items-center">
                    Dr. Feta
                    <svg class="ml-2 w-8 h-8 text-gray-100" fill="currentColor" viewBox="0 0 100 100">
                        <!-- Feta cheese block seen from the side - positioned at bottom -->
                        <!-- Back face (darker) -->
                        <path d="M25 35 L75 30 L75 70 L25 75 Z" fill="#e5e7eb" opacity="0.7"/>

                        <!-- Top face -->
                        <path d="M20 40 L70 35 L75 30 L25 35 Z" fill="currentColor"/>

                        <!-- Front face (main) -->
                        <rect x="20" y="40" width="50" height="35" fill="currentColor"/>

                        <!-- Side edge (darker) -->
                        <path d="M70 35 L75 30 L75 70 L70 75 Z" fill="#d1d5db"/>

                        <!-- Cheese texture and holes -->
                        <ellipse cx="30" cy="50" rx="2" ry="1.5" fill="#9ca3af" opacity="0.8"/>
                        <ellipse cx="45" cy="58" rx="2.5" ry="2" fill="#9ca3af" opacity="0.8"/>
                        <ellipse cx="55" cy="52" rx="1.5" ry="1" fill="#9ca3af" opacity="0.8"/>
                        <ellipse cx="38" cy="65" rx="2" ry="1.5" fill="#9ca3af" opacity="0.8"/>
                        <ellipse cx="58" cy="65" rx="1.5" ry="1" fill="#9ca3af" opacity="0.8"/>

                        <!-- Subtle crumbly texture lines -->
                        <path d="M22 45 L68 43" stroke="#f3f4f6" stroke-width="0.3" opacity="0.6"/>
                        <path d="M22 55 L68 53" stroke="#f3f4f6" stroke-width="0.3" opacity="0.6"/>
                        <path d="M22 65 L68 63" stroke="#f3f4f6" stroke-width="0.3" opacity="0.6"/>

                        <!-- Feta characteristic cracks -->
                        <path d="M35 42 L37 55" stroke="#d1d5db" stroke-width="0.5" opacity="0.7"/>
                        <path d="M52 45 L50 60" stroke="#d1d5db" stroke-width="0.5" opacity="0.7"/>
                    </svg>
                </h1>
                <p class="text-xs text-gray-300">File Egress Transfer Agent</p>
            </div>

            <!-- File Statistics (centered) -->
            <div class="flex justify-center">
                <div class="flex space-x-6 text-sm bg-gray-700 bg-opacity-40 rounded-lg px-4 py-2">
                    <button @click="$store.files.setFilter('all')" :class="{'bg-blue-700': $store.files.activeFilter === 'all'}" class="p-2 rounded-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-opacity-50 transition-colors duration-200">
                        <div class="text-blue-300">Total</div>
                        <strong class="text-white" x-text="$store.files.statistics.totalFiles">0</strong>
                    </button>
                    <button @click="$store.files.setFilter('active')" :class="{'bg-yellow-700': $store.files.activeFilter === 'active'}" class="p-2 rounded-lg hover:bg-yellow-600 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:ring-opacity-50 transition-colors duration-200">
                        <div class="text-yellow-300">Aktive</div>
                        <strong class="text-white" x-text="$store.files.statistics.activeFiles">0</strong>
                    </button>
                    <button @click="$store.files.setFilter('growing')" :class="{'bg-orange-700': $store.files.activeFilter === 'growing'}" class="p-2 rounded-lg hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-opacity-50 transition-colors duration-200">
                        <div class="text-orange-300">Growing</div>
                        <strong class="text-white" x-text="$store.files.statistics.growingFiles">0</strong>
                    </button>
                    <button @click="$store.files.setFilter('completed')" :class="{'bg-green-700': $store.files.activeFilter === 'completed'}" class="p-2 rounded-lg hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-opacity-50 transition-colors duration-200">
                        <div class="text-green-300">Færdige</div>
                        <strong class="text-white" x-text="$store.files.statistics.completedFiles">0</strong>
                    </button>
                    <button @click="$store.files.setFilter('failed')" :class="{'bg-red-700': $store.files.activeFilter === 'failed'}" class="p-2 rounded-lg hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-opacity-50 transition-colors duration-200">
                        <div class="text-red-300">Fejlede</div>
                        <strong class="text-white" x-text="$store.files.statistics.failedFiles">0</strong>
                    </button>
                </div>
            </div>

            <!-- Connection Status og Settings (højre) -->
            <div class="flex justify-end items-center space-x-4">
                <!-- Connection Status -->
                <div class="text-right">
                    <div class="flex items-center justify-end mb-1">
                        <div class="status-indicator rounded-full mr-2"
                             :class="$store.connection?.statusColor || 'bg-gray-500'"></div>
                        <span x-text="$store.connection?.text || 'Indlæser...'" class="text-xs"></span>
                    </div>
                    <div class="text-xs text-gray-300" x-text="$store.connection?.lastUpdate || 'Indlæser...'"></div>
                </div>
            </div>
        </div>

        <!-- Storage Status Panel -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-4">
            <!-- Source Storage -->
            <div class="bg-gray-700 bg-opacity-60 rounded-lg p-4">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-semibold flex items-center">
                        📁 Source Storage
                    </h3>
                    <div class="flex items-center space-x-2">
                        <!-- Browse Button -->
                        <button @click="$store.directoryBrowser.openSourceBrowser()"
                                class="bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded text-xs transition-colors duration-200">
                            📂 Browse
                        </button>
                        <div class="flex items-center">
                            <div class="w-3 h-3 rounded-full mr-2"
                                 :class="$store.storage?.sourceStatusColor || 'bg-gray-500'"></div>
                            <span class="text-sm font-medium"
                                  :class="$store.storage?.sourceStatusTextColor || 'text-gray-400'"
                                  x-text="$store.storage?.sourceStatus || 'Indlæser...'"></span>
                        </div>
                    </div>
                </div>

                <template x-if="$store.storage?.source">
                    <div class="space-y-2">
                        <!-- Storage Bar -->
                        <div class="w-full bg-gray-600 rounded-lg h-4 overflow-hidden">
                            <div class="h-full transition-all duration-500"
                                 :style="`width: ${$store.storage?.sourceUsagePercentage || 0}%`"
                                 :class="$store.storage?.sourceStatusColor || 'bg-gray-500'"></div>
                        </div>

                        <!-- Storage Details -->
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-300">Ledig: <strong class="text-white"
                                                                       x-text="$store.storage?.sourceFreeSpaceFormatted || '0 GB'"></strong></span>
                            <span class="text-gray-300">Total: <strong class="text-white"
                                                                       x-text="$store.storage?.sourceTotalSpaceFormatted || '0 GB'"></strong></span>
                        </div>

                        <!-- Access Status -->
                        <div class="flex space-x-4 text-xs">
                            <div class="flex items-center">
                                <div class="w-2 h-2 rounded-full mr-1"
                                     :class="($store.storage?.sourceAccessible ?? false) ? 'bg-green-500' : 'bg-red-500'"></div>
                                <span :class="($store.storage?.sourceAccessible ?? false) ? 'text-green-400' : 'text-red-400'">
                                        <span x-text="($store.storage?.sourceAccessible ?? false) ? 'Tilgængelig' : 'Utilgængelig'"></span>
                                    </span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-2 h-2 rounded-full mr-1"
                                     :class="($store.storage?.sourceWritable ?? false) ? 'bg-green-500' : 'bg-red-500'"></div>
                                <span :class="($store.storage?.sourceWritable ?? false) ? 'text-green-400' : 'text-red-400'">
                                        <span x-text="($store.storage?.sourceWritable ?? false) ? 'Skrivbar' : 'Skrivebeskyttet'"></span>
                                    </span>
                            </div>
                        </div>
                    </div>
                </template>

                <template x-if="!$store.storage?.source">
                    <div class="text-gray-400 text-sm">Indlæser storage information...</div>
                </template>
            </div>

            <!-- Destination Storage -->
            <div class="bg-gray-700 bg-opacity-60 rounded-lg p-4">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-semibold flex items-center">
                        🎯 Destination Storage
                    </h3>
                    <div class="flex items-center space-x-2">
                        <!-- Browse Button -->
                        <button @click="$store.directoryBrowser.openDestinationBrowser()"
                                class="bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded text-xs transition-colors duration-200">
                            📂 Browse
                        </button>
                        <div class="flex items-center">
                            <div class="w-3 h-3 rounded-full mr-2"
                                 :class="$store.storage?.destinationStatusColor || 'bg-gray-500'"></div>
                            <span class="text-sm font-medium"
                                  :class="$store.storage?.destinationStatusTextColor || 'text-gray-400'"
                                  x-text="$store.storage?.destinationStatus || 'Indlæser...'"></span>
                        </div>
                    </div>
                </div>

                <template x-if="$store.storage?.destination">
                    <div class="space-y-2">
                        <!-- Storage Bar -->
                        <div class="w-full bg-gray-600 rounded-lg h-4 overflow-hidden">
                            <div class="h-full transition-all duration-500"
                                 :style="`width: ${$store.storage?.destinationUsagePercentage || 0}%`"
                                 :class="$store.storage?.destinationStatusColor || 'bg-gray-500'"></div>
                        </div>

                        <!-- Storage Details -->
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-300">Ledig: <strong class="text-white"
                                                                       x-text="$store.storage?.destinationFreeSpaceFormatted || '0 GB'"></strong></span>
                            <span class="text-gray-300">Total: <strong class="text-white"
                                                                       x-text="$store.storage?.destinationTotalSpaceFormatted || '0 GB'"></strong></span>
                        </div>

                        <!-- Access Status -->
                        <div class="flex space-x-4 text-xs">
                            <div class="flex items-center">
                                <div class="w-2 h-2 rounded-full mr-1"
                                     :class="($store.storage?.destinationAccessible ?? false) ? 'bg-green-500' : 'bg-red-500'"></div>
                                <span :class="($store.storage?.destinationAccessible ?? false) ? 'text-green-400' : 'text-red-400'">
                                        <span x-text="($store.storage?.destinationAccessible ?? false) ? 'Tilgængelig' : 'Utilgængelig'"></span>
                                    </span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-2 h-2 rounded-full mr-1"
                                     :class="($store.storage?.destinationWritable ?? false) ? 'bg-green-500' : 'bg-red-500'"></div>
                                <span :class="($store.storage?.destinationWritable ?? false) ? 'text-green-400' : 'text-red-400'">
                                        <span x-text="($store.storage?.destinationWritable ?? false) ? 'Skrivbar' : 'Skrivebeskyttet'"></span>
                                    </span>
                            </div>
                        </div>

                        <!-- Mount Status -->
                        <template x-if="$store.storage?.destinationMountStatus">
                            <div class="mt-2 p-2 bg-gray-800 bg-opacity-50 rounded-md">
                                <div class="flex items-center space-x-2 text-xs">
                                    <div class="flex items-center">
                                        <template x-if="$store.storage?.destinationMountStatus === 'ATTEMPTING'">
                                            <div class="w-3 h-3 mr-2">
                                                <svg class="animate-spin text-blue-400" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10"
                                                            stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor"
                                                          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                </svg>
                                            </div>
                                        </template>
                                        <template x-if="$store.storage?.destinationMountStatus === 'SUCCESS'">
                                            <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
                                        </template>
                                        <template x-if="$store.storage?.destinationMountStatus === 'FAILED'">
                                            <div class="w-2 h-2 bg-red-500 rounded-full mr-2"></div>
                                        </template>
                                        <template x-if="$store.storage?.destinationMountStatus === 'NOT_CONFIGURED'">
                                            <div class="w-2 h-2 bg-gray-500 rounded-full mr-2"></div>
                                        </template>

                                        <span class="text-xs font-medium"
                                              :class="$store.storage?.destinationMountStatusColor">
                                                🔗 Network Mount
                                            </span>
                                    </div>
                                    <span class="text-gray-300 text-xs"
                                          x-text="$store.storage?.destinationMountMessage"></span>
                                </div>
                            </div>
                        </template>
                    </div>
                </template>

                <template x-if="!$store.storage?.destination">
                    <div class="text-gray-400 text-sm">Indlæser storage information...</div>
                </template>
            </div>
        </div>

        <!-- Just In Engine Status Bar (Compact Design) -->
        <div class="bg-gray-700 bg-opacity-60 rounded-lg p-3 mb-4" x-data="{ showDetails: false }">
            <!-- Compact Status Bar -->
            <div class="flex items-center justify-between">
                <!-- Left side: Channel LEDs -->
                <div class="flex items-center space-x-1">
                    <span class="text-sm font-medium text-gray-300 mr-3">🎥 Channels:</span>
                    <template x-for="channel in $store.ingest?.getChannelsSorted() || []" :key="channel.name">
                        <div class="relative group">
                            <!-- LED Indicator -->
                            <div class="w-4 h-4 rounded-full border-2 border-gray-600 transition-all duration-200"
                                 :class="{
                                     'bg-red-500 border-red-400 shadow-lg shadow-red-500/50': channel.is_recording && !channel.has_errors,
                                     'bg-yellow-500 border-yellow-400 shadow-lg shadow-yellow-500/50 animate-pulse': channel.is_recording && channel.has_errors,
                                     'bg-gray-500 border-gray-400': !channel.is_recording && channel.has_signal,
                                     'bg-red-800 border-red-600': !channel.has_signal
                                 }"
                                 :title="`${channel.name}: ${channel.is_recording ? 'Recording' : 'Standby'} ${channel.has_signal ? '' : '(No Signal)'} ${channel.has_errors ? '(Errors)' : ''}`">
                            </div>
                            <!-- Channel Name Label (shows on hover) -->
                            <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 bg-black bg-opacity-90 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-10">
                                <div x-text="channel.name" class="font-medium"></div>
                                <div class="text-gray-300 text-xs">
                                    <span x-text="channel.is_recording ? '🔴 REC' : '⚫ Standby'"></span>
                                    <span x-show="!channel.has_signal" class="text-red-400"> • No Signal</span>
                                    <span x-show="channel.has_errors" class="text-yellow-400"> • Errors</span>
                                </div>
                            </div>
                        </div>
                    </template>
                    <!-- No channels message -->
                    <span x-show="($store.ingest?.getChannelsSorted() || []).length === 0" 
                          class="text-gray-400 text-sm">No channels detected</span>
                </div>

                <!-- Right side: Tally Status & Details Toggle -->
                <div class="flex items-center space-x-3">
                    <!-- Recording Summary -->
                    <div class="text-xs text-gray-300">
                        <span x-text="($store.ingest?.getChannelsSorted() || []).filter(c => c.is_recording).length"></span>/<span x-text="($store.ingest?.getChannelsSorted() || []).length"></span> rec
                    </div>

                    <!-- Tally Light Status -->
                    <div class="flex items-center space-x-2">
                        <span class="text-xs text-gray-400">Tally:</span>
                        <template x-if="$store.ingest?.getRecordingStatus() === 'none'">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-gray-500 rounded-full"></div>
                                <span class="text-xs text-gray-300 ml-1">OFF</span>
                            </div>
                        </template>
                        <template x-if="$store.ingest?.getRecordingStatus() === 'all'">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-red-500 rounded-full shadow-lg shadow-red-500/50"></div>
                                <span class="text-xs text-red-300 ml-1">ON</span>
                            </div>
                        </template>
                        <template x-if="$store.ingest?.getRecordingStatus() === 'some'">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-red-400 rounded-full animate-pulse shadow-lg shadow-red-400/50"></div>
                                <span class="text-xs text-red-300 ml-1">BLINK</span>
                            </div>
                        </template>
                    </div>

                    <!-- Connection Status -->
                    <div class="flex items-center space-x-1">
                        <div class="w-2 h-2 rounded-full"
                             :class="$store.ingest?.isConnected ? 'bg-green-500' : 'bg-red-500'"></div>
                        <span class="text-xs"
                              :class="$store.ingest?.isConnected ? 'text-green-400' : 'text-red-400'"
                              x-text="$store.ingest?.isConnected ? 'Connected' : 'Offline'"></span>
                    </div>

                    <!-- Details Toggle Button -->
                    <button @click="showDetails = !showDetails"
                            class="text-gray-400 hover:text-white text-xs px-2 py-1 rounded hover:bg-gray-600 transition-all duration-200">
                        <span x-text="showDetails ? '▲ Hide' : '▼ Details'"></span>
                    </button>
                </div>
            </div>

            <!-- Detailed View (Expandable) -->
            <div x-show="showDetails" 
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 max-h-0"
                 x-transition:enter-end="opacity-100 max-h-96"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100 max-h-96"
                 x-transition:leave-end="opacity-0 max-h-0"
                 class="mt-4 pt-4 border-t border-gray-600 overflow-hidden">
                
                <!-- Statistics Row -->
                <div class="grid grid-cols-4 gap-3 mb-4">
                    <div class="bg-gray-800 rounded-lg p-3 text-center">
                        <div class="text-lg font-bold text-white" x-text="$store.ingest?.statistics?.totalChannels || 0"></div>
                        <div class="text-xs text-gray-300">Total</div>
                    </div>
                    <div class="bg-gray-800 rounded-lg p-3 text-center">
                        <div class="text-lg font-bold text-red-400" x-text="$store.ingest?.statistics?.recordingChannels || 0"></div>
                        <div class="text-xs text-gray-300">Recording</div>
                    </div>
                    <div class="bg-gray-800 rounded-lg p-3 text-center">
                        <div class="text-lg font-bold text-yellow-400" x-text="$store.ingest?.statistics?.errorChannels || 0"></div>
                        <div class="text-xs text-gray-300">Errors</div>
                    </div>
                    <div class="bg-gray-800 rounded-lg p-3 text-center">
                        <div class="text-lg font-bold text-orange-400" x-text="$store.ingest?.statistics?.signalLostChannels || 0"></div>
                        <div class="text-xs text-gray-300">No Signal</div>
                    </div>
                </div>

                <!-- Channel Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
                    <template x-for="channel in $store.ingest?.getChannelsSorted() || []" :key="channel.name">
                        <div class="bg-gray-800 rounded-lg p-3 border-l-4"
                             :class="channel.is_recording ? 'border-red-500' : (channel.has_signal ? 'border-gray-500' : 'border-yellow-500')">
                            <!-- Channel Header -->
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-medium text-sm" x-text="channel.name"></span>
                                <div class="w-3 h-3 rounded-full"
                                     :class="{
                                         'bg-red-500': channel.is_recording && !channel.has_errors,
                                         'bg-yellow-500 animate-pulse': channel.is_recording && channel.has_errors,
                                         'bg-gray-500': !channel.is_recording && channel.has_signal,
                                         'bg-red-800': !channel.has_signal
                                     }"></div>
                            </div>
                            
                            <!-- Channel Status -->
                            <div class="space-y-1">
                                <div class="flex justify-between text-xs">
                                    <span class="text-gray-400">Status:</span>
                                    <span :class="channel.is_recording ? 'text-red-400' : 'text-gray-300'"
                                          x-text="channel.is_recording ? 'Recording' : 'Standby'"></span>
                                </div>
                                <div class="flex justify-between text-xs">
                                    <span class="text-gray-400">Signal:</span>
                                    <span :class="channel.has_signal ? 'text-green-400' : 'text-red-400'"
                                          x-text="channel.has_signal ? 'OK' : 'No Signal'"></span>
                                </div>
                                <div x-show="channel.is_recording" class="flex justify-between text-xs">
                                    <span class="text-gray-400">Time:</span>
                                    <span class="text-blue-400" 
                                          x-text="`${channel.hours || 0}:${String(channel.minutes || 0).padStart(2, '0')}:${String(channel.seconds || 0).padStart(2, '0')}`"></span>
                                </div>
                                <div x-show="channel.has_errors" class="text-xs text-yellow-400">
                                    ⚠️ <span x-text="channel.last_errors?.length || 0"></span> errors
                                </div>
                            </div>
                        </div>
                    </template>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-between items-center">
                    <div class="text-xs text-gray-400">
                        Last updated: <span x-text="$store.ingest?.lastUpdate ? new Date($store.ingest.lastUpdate).toLocaleTimeString() : 'Never'"></span>
                    </div>
                    <button @click="$store.ingest?.loadInitialData()"
                            class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-xs transition-colors duration-200">
                        🔄 Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- Sort Options og Scanner Status -->
                <h3 class="text-lg font-semibold flex items-center">
                    🎥 Just In Engine Monitor
                </h3>
                <div class="flex items-center space-x-2">
                    <!-- Connection Status -->
                    <div class="flex items-center">
                        <div class="w-3 h-3 rounded-full mr-2"
                             :class="$store.ingest?.isConnected ? 'bg-green-500' : 'bg-red-500'"></div>
                        <span class="text-xs font-medium"
                              :class="$store.ingest?.isConnected ? 'text-green-400' : 'text-red-400'"
                              x-text="$store.ingest?.isConnected ? 'Connected' : 'Disconnected'"></span>
                    </div>
                    <!-- Refresh Button -->
                    <button @click="$store.ingest?.loadInitialData()"
                            class="bg-blue-600 hover:bg-blue-700 text-white px-2 py-1 rounded text-xs transition-colors duration-200">
                        🔄 Refresh
                    </button>
                </div>
            </div>

            <!-- Ingest Statistics -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                <div class="bg-gray-800 bg-opacity-60 rounded-lg p-3 text-center">
                    <div class="text-2xl font-bold text-white" x-text="$store.ingest?.statistics?.totalChannels || 0"></div>
                    <div class="text-xs text-gray-300">Total Channels</div>
                </div>
                <div class="bg-gray-800 bg-opacity-60 rounded-lg p-3 text-center">
                    <div class="text-2xl font-bold text-red-400" x-text="$store.ingest?.statistics?.recordingChannels || 0"></div>
                    <div class="text-xs text-gray-300">Recording</div>
                </div>
                <div class="bg-gray-800 bg-opacity-60 rounded-lg p-3 text-center">
                    <div class="text-2xl font-bold text-yellow-400" x-text="$store.ingest?.statistics?.errorChannels || 0"></div>
                    <div class="text-xs text-gray-300">Errors</div>
                </div>
                <div class="bg-gray-800 bg-opacity-60 rounded-lg p-3 text-center">
                    <div class="text-2xl font-bold text-orange-400" x-text="$store.ingest?.statistics?.signalLostChannels || 0"></div>
                    <div class="text-xs text-gray-300">Signal Lost</div>
                </div>
            </div>

            <!-- Tally Light Status -->
            <div class="bg-gray-800 bg-opacity-60 rounded-lg p-3 mb-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <span class="text-sm font-medium text-gray-300 mr-3">🚨 Tally Light Status:</span>
                        <div class="flex items-center">
                            <template x-if="$store.ingest?.getRecordingStatus() === 'none'">
                                <div class="flex items-center">
                                    <div class="w-4 h-4 bg-gray-500 rounded-full mr-2"></div>
                                    <span class="text-gray-400 text-sm">OFF - No Recording</span>
                                </div>
                            </template>
                            <template x-if="$store.ingest?.getRecordingStatus() === 'all'">
                                <div class="flex items-center">
                                    <div class="w-4 h-4 bg-red-500 rounded-full mr-2"></div>
                                    <span class="text-red-400 text-sm">SOLID - All Recording</span>
                                </div>
                            </template>
                            <template x-if="$store.ingest?.getRecordingStatus() === 'some'">
                                <div class="flex items-center">
                                    <div class="w-4 h-4 bg-red-500 rounded-full mr-2 animate-pulse"></div>
                                    <span class="text-red-400 text-sm">BLINKING - Some Recording</span>
                                </div>
                            </template>
                        </div>
                    </div>
                    <div class="text-xs text-gray-400" x-text="$store.ingest?.lastUpdate ? 'Last update: ' + new Date($store.ingest.lastUpdate).toLocaleTimeString() : 'No data'"></div>
                </div>
            </div>

            <!-- Channel Grid -->
            <template x-if="$store.ingest?.getChannelsArray()?.length > 0">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
                    <template x-for="channel in $store.ingest?.getChannelsSorted() || []" :key="channel.name">
                        <div class="bg-gray-800 bg-opacity-60 rounded-lg p-3 border-l-4"
                             :class="channel.is_recording ? 'border-red-500' : (channel.has_signal ? 'border-green-500' : 'border-yellow-500')">
                            
                            <!-- Channel Header -->
                            <div class="flex items-center justify-between mb-2">
                                <span class="font-bold text-white" x-text="channel.name"></span>
                                <div class="flex items-center space-x-1">
                                    <!-- Recording Indicator -->
                                    <template x-if="channel.is_recording">
                                        <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse" title="Recording"></div>
                                    </template>
                                    <!-- Signal Indicator -->
                                    <div class="w-3 h-3 rounded-full"
                                         :class="channel.has_signal ? 'bg-green-500' : 'bg-yellow-500'"
                                         :title="channel.has_signal ? 'Signal OK' : 'No Signal'"></div>
                                    <!-- Error Indicator -->
                                    <template x-if="channel.has_errors">
                                        <div class="w-3 h-3 bg-yellow-500 rounded-full" title="Has Errors"></div>
                                    </template>
                                </div>
                            </div>

                            <!-- Recording Status -->
                            <div class="text-xs mb-2">
                                <template x-if="channel.is_recording">
                                    <div class="text-red-400 font-medium">
                                        ● RECORDING
                                        <span class="text-gray-300 ml-1" 
                                              x-text="$store.ingest?.formatDuration(channel.hours, channel.minutes, channel.seconds)"></span>
                                    </div>
                                </template>
                                <template x-if="!channel.is_recording">
                                    <div class="text-gray-400">○ STANDBY</div>
                                </template>
                            </div>

                            <!-- Signal Status -->
                            <div class="text-xs mb-2">
                                <span :class="channel.has_signal ? 'text-green-400' : 'text-yellow-400'"
                                      x-text="channel.has_signal ? '📡 Signal OK' : '📡 No Signal'"></span>
                            </div>

                            <!-- Timecode Display -->
                            <template x-if="channel.is_recording">
                                <div class="text-xs text-gray-300 font-mono">
                                    TC: <span x-text="$store.ingest?.formatTimecode(channel.hours, channel.minutes, channel.seconds, channel.frames)"></span>
                                </div>
                            </template>

                            <!-- Error Status -->
                            <template x-if="channel.has_errors && channel.last_error">
                                <div class="mt-2 p-2 bg-yellow-900 bg-opacity-50 rounded text-xs">
                                    <div class="text-yellow-400 font-medium">⚠️ Error</div>
                                    <div class="text-yellow-300" x-text="channel.last_error?.error_message"></div>
                                </div>
                            </template>
                        </div>
                    </template>
                </div>
            </template>

            <!-- No Channels Message -->
            <template x-if="!$store.ingest?.getChannelsArray()?.length">
                <div class="text-gray-400 text-center py-4">
                    <div class="text-lg mb-2">📺</div>
                    <div>No ingest channels available</div>
                    <div class="text-xs mt-1">Check Just In Engine connection</div>
                </div>
            </template>

            <!-- Recent Errors Log -->
            <template x-if="$store.ingest?.getRecentErrors()?.length > 0">
                <div class="mt-4 bg-gray-800 bg-opacity-60 rounded-lg p-3">
                    <div class="flex items-center justify-between mb-2">
                        <h4 class="text-sm font-medium text-white">Recent Errors</h4>
                        <button @click="$store.ingest?.clearErrors()"
                                class="text-xs text-red-400 hover:text-red-300 transition-colors">
                            Clear All
                        </button>
                    </div>
                    <div class="space-y-2 max-h-32 overflow-y-auto">
                        <template x-for="error in $store.ingest?.getRecentErrors() || []" :key="error.id">
                            <div class="flex items-center justify-between text-xs p-2 bg-gray-900 bg-opacity-40 rounded">
                                <div class="flex items-center space-x-2">
                                    <span class="text-yellow-400" x-text="error.channel_name"></span>
                                    <span class="text-gray-300" x-text="error.error_message"></span>
                                </div>
                                <span class="text-gray-500" x-text="new Date(error.timestamp).toLocaleTimeString()"></span>
                            </div>
                        </template>
                    </div>
                </div>
            </template>
        </div>

        <!-- Sort Options og Scanner Status -->
        <div class="flex items-center">
            <!-- Scanner Status (venstre) -->
            <div class="flex items-center flex-1">
                <div class="status-indicator rounded-full mr-2"
                     :class="$store.ui?.scanner?.scanning ? 'bg-green-500' : ($store.ui?.scanner?.paused ? 'bg-orange-500' : 'bg-gray-500')"></div>
                <span class="text-xs text-gray-300">
                    <span x-show="$store.ui?.scanner?.scanning">🔍 Scanner Active</span>
                    <span x-show="$store.ui?.scanner?.paused">⏸️ Scanner Paused</span>
                    <span x-show="!$store.ui?.scanner?.scanning && !$store.ui?.scanner?.paused">❓ Scanner Unknown</span>
                </span>
            </div>

            <!-- Action Buttons (midten) -->
            <div class="flex items-center justify-center space-x-3 flex-1">
                <!-- Logs Button -->
                <button @click="openLogViewerModal()"
                        class="bg-gray-600 hover:bg-gray-500 text-white px-3 py-1 rounded-lg text-sm transition-colors duration-200">
                    📝 Logs
                </button>

                <!-- Events Button -->
                <button @click="$store.eventsViewer.openModal()"
                        class="bg-purple-600 hover:bg-purple-500 text-white px-3 py-1 rounded-lg text-sm transition-colors duration-200">
                    📊 Events
                </button>

                <!-- Settings Button -->
                <button @click="openSettingsModal()"
                        class="bg-gray-600 hover:bg-gray-500 text-white px-3 py-1 rounded-lg text-sm transition-colors duration-200">
                    ⚙️ Settings
                </button>
            </div>

            <!-- Sort Options (højre) -->
            <div class="flex items-center justify-end space-x-4 flex-1">
                <span class="text-gray-300 text-sm">Sorter efter:</span>
                <select x-model="$store.files.sortBy"
                        @change="$store.files.setSortBy($event.target.value)"
                        class="bg-gray-700 text-white text-sm rounded px-3 py-1 border border-gray-600">
                    <option value="activity">Seneste aktivitet</option>
                    <option value="discovered">Opdaget tidspunkt</option>
                    <option value="started">Startet tidspunkt</option>
                    <option value="completed">Færdig tidspunkt</option>
                    <option value="filename">Filnavn</option>
                    <option value="size">Filstørrelse</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Files List -->
    <div class="space-y-2 mt-2">

        <template x-for="file in $store.files.filteredFiles" :key="file.id">
            <!-- Simple File Row with Hover Tooltip -->
            <div class="bg-gray-800 hover:bg-gray-900 rounded-lg p-3 mb-2 shadow-lg relative group cursor-pointer">
                <div class="flex items-center space-x-4">

                    <!-- File Name -->
                    <div class="flex-1 min-w-0">
                        <div class="text-white font-bold truncate" x-text="UIHelpers.getFileName(file.file_path)"></div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="flex-1">
                        <div class="w-full bg-gray-700 rounded overflow-hidden">
                            <div class="py-1 text-xs text-center rounded text-white transition-all duration-500 ease-out"
                                 :style="UIHelpers.getProgressWidth(file)"
                                 :class="UIHelpers.getProgressColor(file)"
                                 x-text="UIHelpers.getProgressText(file)">
                            </div>
                        </div>
                    </div>


                    <!-- Status -->
                    <div class="w-32 text-center">
                        <div class="inline-block py-1 px-2 rounded-full text-xs font-bold"
                             :class="UIHelpers.getStatusBadgeColor(file.status)"
                             x-text="UIHelpers.getFriendlyStatus(file.status)">
                        </div>
                    </div>

                    <div class="w-40 text-center text-xs">
                        <div class="text-white text-xs"
                             x-text="UIHelpers.formatCustomDateTime(file.discovered_at)"></div>
                    </div>

                    <!-- Bytes Copied -->
                    <div class="w-32 text-center text-xs">
                        <div x-show="file.bytes_copied && file.file_size" class="text-green-300">
                            <span x-text="UIHelpers.formatBytesCopied(file.bytes_copied, file.file_size)"></span>
                        </div>
                    </div>
                </div>

                <!-- Hover Tooltip with Additional Info -->
                <div class="absolute top-full left-0 mt-2 w-[500px] bg-gray-900 text-white p-4 rounded-lg shadow-xl z-50 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
                    <div class="grid grid-cols-2 gap-6 text-sm">
                        <!-- Left Column -->
                        <div class="space-y-2">
                            <div>
                                <span class="text-gray-400">Full Path:</span>
                                <div class="text-white text-xs break-all" x-text="file.file_path"></div>
                            </div>
                            <div>
                                <span class="text-gray-400">Discovered:</span>
                                <div class="text-white" x-text="UIHelpers.formatDateTime(file.discovered_at)"></div>
                            </div>
                            <div x-show="file.started_copying_at">
                                <span class="text-gray-400">Started:</span>
                                <div class="text-green-300"
                                     x-text="UIHelpers.formatDateTime(file.started_copying_at)"></div>
                            </div>
                            <div x-show="file.completed_at">
                                <span class="text-gray-400">Completed:</span>
                                <div class="text-blue-300" x-text="UIHelpers.formatDateTime(file.completed_at)"></div>
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="space-y-2">
                            <div>
                                <span class="text-gray-400">File Size:</span>
                                <div class="text-white" x-text="UIHelpers.formatFileSizeMB(file.file_size_mb)"></div>
                            </div>
                            <div>
                                <span class="text-gray-400">Retry Count:</span>
                                <div class="text-white font-bold" x-text="file.retry_count"></div>
                            </div>
                            <div x-show="UIHelpers.isGrowingFile(file)">
                                <span class="text-gray-400">Growing File:</span>
                                <div class="text-orange-300">
                                    <span x-text="UIHelpers.getGrowingFileIcon(file)"></span>
                                    Yes
                                </div>
                            </div>
                            <div x-show="file.copy_speed_mbps && file.copy_speed_mbps > 0">
                                <span class="text-gray-400">Copy Speed:</span>
                                <div class="text-blue-300"
                                     x-text="(file.copy_speed_mbps || 0).toFixed(1) + ' MB/s'"></div>
                            </div>
                            <div x-show="file.bytes_copied">
                                <span class="text-gray-400">Progress:</span>
                                <div class="text-green-300"
                                     x-text="UIHelpers.formatBytesCopied(file.bytes_copied, file.file_size)"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Arrow pointing up -->
                    <div class="absolute bottom-full left-8 w-0 h-0 border-l-8 border-r-8 border-b-8 border-l-transparent border-r-transparent border-b-gray-900"></div>
                </div>

                <!-- Error Message -->
                <div x-show="file.error_message"
                     class="mt-2 p-2 bg-red-900 bg-opacity-50 rounded border border-red-600">
                    <div class="flex items-center">
                        <svg class="w-4 h-4 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                                  clip-rule="evenodd"></path>
                        </svg>
                        <span class="text-red-200 text-xs" x-text="file.error_message"></span>
                    </div>
                </div>
            </div>
        </template>

        <!-- Empty State -->
        <div x-show="$store.files.filteredFiles.length === 0" class="text-center">
            <div class="text-gray-300 text-lg bg-gray-800 bg-opacity-60 rounded-lg p-8">
                <div class="text-4xl mb-4">📁</div>
                Ingen filer fundet
            </div>
        </div>
    </div>
</div>

<!-- Log Viewer Modal -->
{% include "components/log_viewer_modal.html" %}

<!-- Events Viewer Modal -->
{% include "components/events_viewer_modal.html" %}

<!-- Settings Modal -->
{% include "components/settings_modal.html" %}

<!-- Directory Browser Modal -->
{% include "components/directory_browser_modal.html" %}

<!-- Error Container for initialization failures -->
<div id="error-container" style="display: none;" class="fixed top-4 right-4 max-w-md z-50"></div>

</body>
</html>